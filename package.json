{
  "name": "storeforge",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @storeforge/db generate",
    "db:migrate": "pnpm --filter @storeforge/db migrate:dev",
    "db:push": "pnpm --filter @storeforge/db push",
    "db:seed": "pnpm --filter @storeforge/db seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:deploy": "pnpm --filter @storeforge/db migrate:deploy",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "sharp@<0.35.5": "^0.35.5",
      "multer@<2.1.0": "^2.1.0",
      "body-parser@<1.20.6": "^1.20.6",
      "qs@<6.15.2": "^6.15.2",
      "js-yaml@>=4 <4.1.1": "^4.1.1",
      "lodash@<4.18.0": "^4.18.0",
      "postcss@<8.5.10": "^8.5.10",
      "source-map-js@<1.2.2": "^1.2.2",
      "deepmerge-ts@<8.0.0": "^8.0.0",
      "file-type@<21.3.1": "^21.3.1",
      "zod@>=4 <4.6.6": "^4.6.6"
    }
  }
}
