generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
  SOFT_DELETED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  AWAITING_MERCHANT_APPROVAL
  FULFILLMENT_SUBMITTED
  SHIPPED
  DELIVERED
  REFUNDED
  CANCELLED
  FAILED
}

/// Custom domain lifecycle (Phase 1 slice 2)
enum DomainStatus {
  PENDING_DNS // waiting for the merchant's TXT + CNAME/A records
  ISSUING_TLS // DNS verified; certificate being issued
  ACTIVE // verified + TLS ready; storefront served on this host
  FAILED // gave up (no DNS after DOMAIN_DNS_TIMEOUT_HOURS, or TLS error)
}

enum EmailKind {
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_REFUNDED
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

enum FulfillmentStatus {
  PENDING
  APPROVED
  SUBMITTED
  SHIPPED
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  image         String?
  passwordHash  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships OrganizationMember[]
}

/// Better Auth session
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Better Auth OAuth / credential account link
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Merchant organization (tenant)
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Platform-side billing customer (Stripe `cus_…`): SaaS plan + Ad Fuel top-ups
  billingCustomerId      String?   @unique
  /// Merchant payout account (Stripe Connect Express `acct_…`), one per merchant
  payoutProvider         String?
  payoutAccountId        String?   @unique
  payoutChargesEnabled   Boolean   @default(false)
  payoutPayoutsEnabled   Boolean   @default(false)
  payoutDetailsSubmitted Boolean   @default(false)
  payoutUpdatedAt        DateTime?

  members      OrganizationMember[]
  stores       Store[]
  subscription Subscription?
  adWallet     AdWallet?
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("owner")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Plan {
  id                String   @id // starter | growth | scale
  name              String
  priceUsd          Int
  maxStores         Int
  maxOrdersPerMonth Int
  /// Provider price id (Stripe `price_…`); env STRIPE_PRICE_* overrides at runtime
  providerPriceId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  planId                 String
  status                 SubscriptionStatus @default(INCOMPLETE)
  provider               String             @default("stub") // stub | stripe
  providerSubscriptionId String?            @unique
  providerCustomerId     String?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
}

model Store {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  slug           String      @unique
  theme          String      @default("default")
  customDomain   String?
  status         StoreStatus @default(ACTIVE)
  autoFulfill    Boolean     @default(false)
  /// Risk flag shown in admin (e.g. open_disputes)
  riskFlag       String?
  riskFlaggedAt  DateTime?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storeProducts StoreProduct[]
  orders        Order[]
  domains       Domain[]
  emails        EmailMessage[]
  adConnections AdConnection[]
  adAccounts    AdAccount[]
  campaigns     AdCampaign[]
  conversions   ConversionEvent[]

  @@index([organizationId])
  @@index([status])
}

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique // cj | spocket | zendrop
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  mappings     SupplierProductMapping[]
  fulfillments Fulfillment[]
}

/// Platform catalog product (shared across merchants)
model Product {
  id            String   @id @default(cuid())
  supplierId    String
  externalId    String
  title         String
  description   String   @default("")
  sku           String
  priceCents    Int
  costCents     Int
  currency      String   @default("USD")
  imageUrl      String?
  category      String?
  etaDaysMin    Int      @default(7)
  etaDaysMax    Int      @default(21)
  sourcingLabel String   @default("Ships from supplier warehouse")
  stock         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier      Supplier                 @relation(fields: [supplierId], references: [id])
  storeProducts StoreProduct[]
  mappings      SupplierProductMapping[]

  @@unique([supplierId, externalId])
  @@index([sku])
  @@index([category])
}

model SupplierProductMapping {
  id                String   @id @default(cuid())
  supplierId        String
  productId         String
  externalSku       String
  externalVariantId String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
}

/// Merchant store listing (price override)
model StoreProduct {
  id             String    @id @default(cuid())
  storeId        String
  productId      String
  title          String?
  priceCents     Int
  compareAtCents Int?
  active         Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store   Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])
  lines   OrderLine[]

  @@unique([storeId, productId])
  @@index([storeId])
}

model Order {
  id                 String      @id @default(cuid())
  storeId            String
  status             OrderStatus @default(PENDING_PAYMENT)
  customerEmail      String
  customerName       String
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingState      String
  shippingPostalCode String
  shippingCountry    String      @default("US")
  currency           String      @default("USD")
  subtotalCents      Int
  shippingCents      Int         @default(0)
  totalCents         Int
  platformFeeCents   Int         @default(0)
  provider           String      @default("stub") // stub | stripe
  /// Stripe PaymentIntent id (`pi_…`) once paid
  providerPaymentId  String?     @unique
  /// Stripe Checkout Session id (`cs_…`)
  providerCheckoutId String?     @unique
  /// Connected account the charge was routed to (destination charge)
  payoutAccountId    String?
  /// Admin-visible problem: payment_mismatch | dispute_open | dispute_lost (null = fine)
  flag               String?
  flagDetail         String?
  flaggedAt          DateTime?
  /// Sum of succeeded + in-flight refunds (reserved before the provider call)
  refundedCents      Int         @default(0)
  /// Ads attribution captured at checkout (slice 3): { consent, fbp, fbc, ip, ua, sourceUrl }
  attribution        Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  store          Store           @relation(fields: [storeId], references: [id])
  lines          OrderLine[]
  fulfillment    Fulfillment?
  trackingEvents TrackingEvent[]
  refunds        OrderRefund[]
  emails         EmailMessage[]

  @@index([storeId])
  @@index([status])
  @@index([customerEmail])
}

model OrderLine {
  id             String @id @default(cuid())
  orderId        String
  storeProductId String
  title          String
  sku            String
  quantity       Int
  unitPriceCents Int
  unitCostCents  Int

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id])

  @@index([orderId])
}

model Fulfillment {
  id             String            @id @default(cuid())
  orderId        String            @unique
  supplierId     String
  status         FulfillmentStatus @default(PENDING)
  externalId     String?
  trackingNumber String?
  carrier        String?
  submittedAt    DateTime?
  shippedAt      DateTime?
  errorMessage   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id])
}

model TrackingEvent {
  id          String   @id @default(cuid())
  orderId     String
  status      String
  description String
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Optional prepaid wholesale balance (stub for Phase 0)
model DepositBalance {
  id             String   @id @default(cuid())
  organizationId String   @unique
  balanceCents   Int      @default(0)
  currency       String   @default("USD")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

/// Processed payment-provider webhook events (replay protection, keyed on provider event id)
model WebhookEvent {
  id          String    @id // provider event id, e.g. evt_…
  provider    String
  endpoint    String // platform | connect
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  /// Claim lease: only the worker that holds it dispatches the event (concurrent deliveries → 200, no dispatch)
  lockedUntil DateTime?
  attempts    Int       @default(1)
  lastError   String?

  @@index([type])
}

enum WalletTxnKind {
  TOPUP
  SPEND
  FEE
  REFUND
  BONUS
  ADJUST
}

/// Ad Fuel wallet (prepaid promotion credit). Phase 1 slice 3 builds the UI/jobs on top.
model AdWallet {
  id                 String    @id @default(cuid())
  organizationId     String    @unique
  balanceCents       Int       @default(0) // refundable fuel
  bonusCents         Int       @default(0) // promo fuel, never refundable
  autoReloadCents    Int       @default(0)
  thresholdCents     Int       @default(0)
  currency           String    @default("USD")
  /// Auto-reload (slice 3): off-session charge of autoReloadCents when fuel < thresholdCents
  autoReloadEnabled  Boolean   @default(false)
  /// Card saved by a top-up (setup_future_usage=off_session)
  paymentMethodId    String?
  paymentMethodLabel String?
  /// Single-flight claim: set while a reload is in flight (key = sf-autoreload-<wallet>-<seq>)
  reloadSeq          Int       @default(0)
  reloadInFlight     Boolean   @default(false)
  reloadStartedAt    DateTime?
  /// Amount claimed for the in-flight reload (a retry must reuse it with the same idempotency key)
  reloadAmountCents  Int       @default(0)
  reloadFailures     Int       @default(0)
  reloadLastError    String?
  lowFuelAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  txns         WalletTxn[]
}

model WalletTxn {
  id                String        @id @default(cuid())
  walletId          String
  kind              WalletTxnKind
  /// Signed: credits > 0, debits < 0
  amountCents       Int
  provider          String        @default("stub")
  /// PaymentIntent id for TOPUP; unique per kind so a replayed webhook can't double-credit
  providerPaymentId String?
  /// Refund id for REFUND / reversal ADJUST
  providerRefundId  String?
  /// For REFUND: the TOPUP txn being refunded
  refundOfId        String?
  status            String        @default("succeeded") // pending | unknown | succeeded | failed
  /// REFUND: last provider error (an "unknown" refund is never restored until confirmed failed)
  lastError         String?
  reconciledAt      DateTime?
  campaignId        String?
  day               DateTime?
  /// TOPUP: manual | auto
  source            String?
  /// Wallet balances right after this entry (ledger running balance)
  balanceAfterCents Int?
  bonusAfterCents   Int?
  /// Debits: which part of the charge came from bonus fuel (<= 0)
  bonusCents        Int           @default(0)
  note              String?
  createdAt         DateTime      @default(now())

  wallet AdWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([kind, providerPaymentId])
  @@unique([kind, providerRefundId])
  @@index([walletId])
}

/// Card dispute (chargeback). Destination charges live on the platform account, so disputes arrive there.
model Dispute {
  id                String    @id @default(cuid())
  provider          String    @default("stripe")
  providerDisputeId String    @unique
  chargeId          String?
  paymentIntentId   String?
  orderId           String?
  storeId           String?
  organizationId    String?
  amountCents       Int
  currency          String
  reason            String?
  /// warning_needs_response | needs_response | under_review | won | lost | …
  status            String
  evidenceDueBy     DateTime?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([orderId])
  @@index([organizationId])
}

/// In-app alerts. organizationId null = platform/ops alert.
model Notification {
  id             String    @id @default(cuid())
  organizationId String?
  /// dispute_opened | dispute_updated | dispute_closed | payment_mismatch | refund_stuck
  kind           String
  severity       String    @default("warning") // info | warning | critical
  title          String
  body           String
  orderId        String?
  /// Exactly-once per (event, state)
  dedupeKey      String    @unique
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, createdAt])
}

/// A merchant's own hostname for a store (blueprint §4: Domain(storeId, host, status, verifiedAt)).
model Domain {
  id                String       @id @default(cuid())
  storeId           String
  /// Lower-case, no port, no trailing dot. Globally unique.
  host              String       @unique
  status            DomainStatus @default(PENDING_DNS)
  /// Value expected in TXT _storeforge.<host> = "storeforge-verify=<token>"
  verificationToken String
  /// Primary domain is used for links in emails and checkout return URLs
  isPrimary         Boolean      @default(false)
  /// DNS ownership + routing verified
  verifiedAt        DateTime?
  /// The edge IP DNS verification matched (ours). The HTTPS probe is pinned to it, so a DNS change
  /// after verification can't point our probe somewhere else (SSRF / DNS rebinding).
  verifiedIp        String?
  tlsRequestedAt    DateTime?
  tlsIssuedAt       DateTime?
  tlsProvider       String       @default("stub") // stub | caddy | vercel
  /// Start of the current DNS wait window ("Check again" on a FAILED domain restarts it)
  windowStartedAt   DateTime     @default(now())
  lastCheckedAt     DateTime?
  nextCheckAt       DateTime     @default(now())
  checkCount        Int          @default(0)
  /// Last check result per record, for the admin screen: { txt, routing, tls }
  lastResult        Json?
  lastError         String?
  /// Dev/stub DNS only: merchant pressed "Simulate DNS" (never consulted in live DNS mode)
  devDnsSimulatedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([status, nextCheckAt])
}

/// Storefront order refund (Stripe Refund on the destination charge, reverse_transfer).
model OrderRefund {
  id               String    @id @default(cuid())
  orderId          String
  amountCents      Int
  reason           String?
  /// Merchant-supplied request id; makes the POST idempotent
  requestId        String
  provider         String    @default("stub")
  providerRefundId String?   @unique
  status           String    @default("pending") // pending | unknown | succeeded | failed | canceled
  /// Last time the reconciler asked the provider about a pending/unknown refund
  reconciledAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, requestId])
  @@index([orderId])
}

/// Every customer email. dedupeKey makes each trigger fire once (webhook replays, tracking re-polls).
model EmailMessage {
  id                String      @id @default(cuid())
  storeId           String?
  orderId           String?
  kind              EmailKind
  dedupeKey         String      @unique
  to                String
  from              String
  replyTo           String?
  subject           String
  html              String
  text              String
  status            EmailStatus @default(QUEUED)
  /// resend | outbox (dev: written to EMAIL_OUTBOX_DIR, nothing leaves the box)
  transport         String?
  providerMessageId String?
  attempts          Int         @default(0)
  lastError         String?
  sentAt            DateTime?
  /// Send lease: whoever holds it delivers (inline send, worker and outbox sweeper never double-send)
  lockedUntil       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([orderId])
}

// ---------------- Phase 1 slice 3: Boost (Meta connect-your-own) + Ad Fuel jobs ----------------

enum AdChannel {
  META
  GOOGLE
  TIKTOK
}

enum AdAccountMode {
  MANAGED
  OWNED
}

enum AdCampaignStage {
  DRAFT
  REVIEW
  WARMING
  STEADY
  PAUSED
  REJECTED
}

/// One-time OAuth state (CSRF + binds the callback to the store/user that started it)
model OAuthState {
  id        String    @id // random nonce sent as `state`
  channel   AdChannel
  storeId   String
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// OAuth grant for a store (merchant's own Meta login). Token is AES-256-GCM encrypted.
model AdConnection {
  id             String    @id @default(cuid())
  storeId        String
  channel        AdChannel
  externalUserId String
  externalName   String?
  tokenCipher    String
  tokenExpiresAt DateTime?
  scopes         String[]
  status         String    @default("active") // active | expired | revoked
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  accounts AdAccount[]

  @@unique([storeId, channel])
}

model AdAccount {
  id            String        @id @default(cuid())
  storeId       String
  channel       AdChannel
  mode          AdAccountMode
  externalId    String // act_123…
  name          String
  currency      String        @default("USD")
  timezone      String?
  status        String        @default("active") // active | disabled | disconnected
  /// OWNED: AdConnection id holding the token; MANAGED: platform system user
  tokenRef      String?
  pixelId       String?
  pixelName     String?
  /// Facebook Page the ads run as (object_story_spec.page_id)
  pageId        String?
  pageName      String?
  /// Meta Events Manager "Test events" code; sent as test_event_code while set
  testEventCode String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  store      Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection AdConnection? @relation(fields: [tokenRef], references: [id], onDelete: SetNull)
  campaigns  AdCampaign[]

  @@unique([storeId, channel, mode])
}

model AdCampaign {
  id                 String          @id @default(cuid())
  storeId            String
  adAccountId        String
  storeProductId     String?
  channel            AdChannel
  name               String
  /// Meta ids, filled step by step so a retried launch resumes instead of duplicating
  externalId         String?
  externalAdSetId    String?
  externalAdId       String?
  externalCreativeId String?
  dailyBudgetCents   Int
  stage              AdCampaignStage @default(DRAFT)
  ladderStep         Int             @default(0)
  /// Merchant's idempotency key for "create campaign"
  requestId          String
  pausedReason       String? // merchant | low_fuel | rejected | disconnected
  lastError          String?
  launchedAt         DateTime?
  /// Short lease while a launch talks to Meta (double-click / two workers can't create twice)
  launchLockedUntil  DateTime?
  lastSyncedAt       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  adAccount AdAccount        @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  creatives AdCreative[]
  insights  AdInsightDaily[]
  charges   AdChargeDay[]

  @@unique([storeId, requestId])
  @@index([stage])
}

model AdCreative {
  id           String   @id @default(cuid())
  campaignId   String
  type         String   @default("image") // image | video | carousel
  assetUrl     String?
  headline     String
  body         String
  policyStatus String   @default("pending") // pending | approved | rejected
  createdAt    DateTime @default(now())

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model AdInsightDaily {
  id           String   @id @default(cuid())
  campaignId   String
  date         DateTime @db.Date
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  spendCents   Int      @default(0)
  purchases    Int      @default(0)
  revenueCents Int      @default(0)
  syncedAt     DateTime @default(now())

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
}

/// What a campaign owes the wallet for one day vs what was actually debited. Debits are deltas
/// against this row, taken under a wallet row lock, so re-running the job never double-charges.
model AdChargeDay {
  id                String   @id @default(cuid())
  campaignId        String
  walletId          String
  date              DateTime @db.Date
  spendOwedCents    Int      @default(0)
  feeOwedCents      Int      @default(0)
  spendDebitedCents Int      @default(0)
  feeDebitedCents   Int      @default(0)
  /// Owed but not covered by fuel (wallet ran dry); campaign is paused, settled on next top-up
  shortfallCents    Int      @default(0)
  updatedAt         DateTime @updatedAt

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([walletId])
}

/// Server-side conversion (Meta CAPI). eventId is shared with the browser pixel for dedupe.
model ConversionEvent {
  id            String    @id @default(cuid())
  storeId       String
  orderId       String
  eventName     String // Purchase
  eventId       String    @unique
  sentMeta      Boolean   @default(false)
  sentGoogle    Boolean   @default(false)
  sentTikTok    Boolean   @default(false)
  metaStatus    String    @default("pending") // pending | sent | skipped | failed
  metaTrace     String?
  testEventCode String?
  attempts      Int       @default(0)
  lastError     String?
  payload       Json?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}
