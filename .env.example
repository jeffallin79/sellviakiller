# Copy THIS file to .env. Testers: never copy a build box's .env (it is a local demo file with
# ALLOW_STUB_PAY=true and other dev-only settings).

# Database / Redis
DATABASE_URL=postgresql://storeforge:storeforge@localhost:5432/storeforge?schema=public
REDIS_URL=redis://localhost:6379

# App URLs
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3001
STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN=storeforge.local

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:4000
# Cookie / trusted origins (comma-separated)
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://admin.storeforge.local:3001

# Payments: Stripe (switched from Square 2026-11-12). Leave STRIPE_SECRET_KEY blank = stub mode.
# Use TEST keys (sk_test_/pk_test_). Live keys are refused unless STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Platform webhook endpoint  {API_URL}/api/webhooks/stripe  (signing secret whsec_…)
STRIPE_WEBHOOK_SECRET=
# Connect webhook endpoint   {API_URL}/api/webhooks/stripe/connect  ("Events on connected accounts")
STRIPE_CONNECT_WEBHOOK_SECRET=
# STRIPE_CONNECT_CLIENT_ID — UNUSED. Only for OAuth-style Connect (Standard accounts); StoreForge uses
# Express accounts onboarded with Account Links, so leave it unset.
# STRIPE_CONNECT_CLIENT_ID=
# Recurring monthly Price ids for the plans ($29 / $79 / $199)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_ALLOW_LIVE=false
# Platform application fee on storefront orders, basis points (0 = none; plans carry revenue)
PLATFORM_FEE_BPS=0
# Ad Fuel refunds: processor-cost deduction (blueprint "minus processor costs"); 0 until decided
FUEL_REFUND_FEE_BPS=0
FUEL_REFUND_FEE_FIXED_CENTS=0
# How often pending/unknown Ad Fuel refunds are confirmed against Stripe (ms; 0 = off)
FUEL_RECONCILE_MS=600000

# ---------------------------------------------------------------------------------------------
# Boost + Meta (slice 3). Leave META_APP_ID / META_APP_SECRET blank (or META_MODE=stub) = stub Meta:
# simulated OAuth screen, ad accounts, campaigns, insights and a Test Events view. No real ads.
# Live needs a Business-type Meta app with Facebook Login for Business + Marketing API, and
# Advanced Access (App Review) for: ads_management, ads_read, business_management,
# pages_show_list, pages_read_engagement. Valid OAuth redirect URI in the app:
#   {API_PUBLIC_URL}/api/boost/meta/callback
META_MODE=
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business "configuration" id (the permission set merchants approve)
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v26.0
# Boost Managed on Meta (slice 4): StoreForge's own Business Manager creates one ad account + Pixel per
# store. Live when META_BUSINESS_ID + META_SYSTEM_USER_TOKEN + META_APP_SECRET + META_MANAGED_PAGE_ID are
# all set (and META_MODE != stub). The system user (Admin) needs ads_management, business_management,
# ads_read; the app needs Full access (formerly "Advanced") for those. Every call sends appsecret_proof.
# "Connect your own" purchases still go to the merchant's Pixel with the merchant's own token.
META_BUSINESS_ID=
META_SYSTEM_USER_TOKEN=
META_CAPI_TOKEN=
# The Facebook Page managed ads run as (StoreForge's Page, owned by the Business Manager)
META_MANAGED_PAGE_ID=
# Business Manager time zone id for new ad accounts (1 = America/Los_Angeles; see Graph timezone ids)
META_MANAGED_TIMEZONE_ID=1
# Lowest spend_cap Meta accepts (minor units). Below it, the low-fuel pause is the backstop.
META_MIN_SPEND_CAP_CENTS=10000
# META_MANAGED_STUB_STATE_FILE=.stub-meta-managed.json

# ---------------------------------------------------------------------------------------------
# Boost Managed on Google Ads (slice 4): Performance Max under StoreForge's manager account (MCC), one
# client account + one Merchant Center sub-account per store. Live when the 5 required vars are set and
# GOOGLE_ADS_MODE != stub. Since 2026-09-09 the API access level belongs to the Google Cloud project that
# owns the OAuth client (Test → Explorer → Basic → Standard); a developer token is optional and ignored.
# OAuth scopes: https://www.googleapis.com/auth/adwords  https://www.googleapis.com/auth/content
GOOGLE_ADS_MODE=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Refresh token of the MCC admin user who granted both scopes (offline access)
GOOGLE_ADS_REFRESH_TOKEN=
# Manager (MCC) customer id, digits only; sent as login-customer-id
GOOGLE_ADS_MCC_ID=
# Merchant Center advanced (multi-client) account id
GOOGLE_MERCHANT_CENTER_ID=
# Payments account for consolidated (monthly invoicing) billing setups: 1234-5678-9012-3456
GOOGLE_ADS_PAYMENTS_ACCOUNT_ID=
GOOGLE_ADS_API_VERSION=v26
# Optional (legacy, ignored by Google since 2026-09-09)
GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_STUB_STATE_FILE=.stub-google.json

# ---------------------------------------------------------------------------------------------
# Boost Managed on TikTok (slice 4): one advertiser per store under StoreForge's Business Center,
# prepaid by BC transfers. Live when TIKTOK_APP_ID + TIKTOK_APP_SECRET + TIKTOK_ACCESS_TOKEN +
# TIKTOK_BC_ID are set and TIKTOK_MODE != stub.
TIKTOK_MODE=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Long-term access token of a BC Admin who authorised the app (Business Center + Ads Management +
# Reporting + Pixel/Events + Catalog scopes)
TIKTOK_ACCESS_TOKEN=
TIKTOK_BC_ID=
# customer_info.industry for new advertisers: pick the id from GET /tools/industry/get/ (291505 is a placeholder; VERIFY)
TIKTOK_INDUSTRY_ID=291505
TIKTOK_API_BASE=https://business-api.tiktok.com/open_api/v1.3
# TIKTOK_STUB_STATE_FILE=.stub-tiktok.json
# Dev only: where the stub Meta keeps its state between restarts (gitignored)
# META_STUB_STATE_FILE=.stub-meta.json
# Public URL Facebook redirects back to. SET BOTH API_PUBLIC_URL and ADMIN_URL to the hosts the
# browser really uses (e.g. http://localhost:4000 / http://localhost:3001 in dev): the OAuth
# redirect_uri is built from API_PUBLIC_URL and the callback then sends the merchant to ADMIN_URL.
# A 127.0.0.1 vs localhost mismatch = wrong host, lost admin cookie, CORS failure.
API_PUBLIC_URL=
# Encrypts merchants' ad tokens at rest (AES-256-GCM). REQUIRED unless NODE_ENV=development|test
# (the API refuses to start without it). Generate once and never rotate without re-sealing:
#   openssl rand -base64 32
# The dev fallback is derived from BETTER_AUTH_SECRET: changing that secret breaks stored tokens.
ADS_TOKEN_KEY=
# Boost fee as % of ad spend. Managed (our ad account; slice 4): fuel pays spend + fee.
ADS_FEE_PCT=15
# Connect-your-own: Meta bills the merchant for spend; fuel only pays this fee (0 = no fuel used).
ADS_OWNED_FEE_PCT=0
ADS_MIN_DAILY_CENTS=500
# Auto-reload: at most this many charges per wallet per UTC day
ADS_AUTORELOAD_MAX_PER_DAY=3
# Insights pull + fuel charge interval (ms). Blueprint: hourly.
ADS_SYNC_MS=3600000
# Managed Boost (slice 4)
# Channels offered (comma list of META,GOOGLE,TIKTOK; default all three)
ADS_MANAGED_CHANNELS=META,GOOGLE,TIKTOK
# Lowest total daily budget across channels (TikTok alone needs $20/day per ad group)
ADS_MANAGED_MIN_DAILY_CENTS=1000
# Time zone of the managed ad accounts (Google / TikTok); reports and charge days follow it
ADS_MANAGED_TIMEZONE=America/New_York
# Daily reconcile: drift above this (basis points, 100 = 1%) alerts ops; any drift is corrected
ADS_RECONCILE_ALERT_BPS=100
# Creative crops: where bundled product images live (default ../storefront/public/catalog)
# CATALOG_ASSET_DIR=
# Stub platforms (dev): seconds before a new ad is "approved", per-call latency
# STUB_ADS_REVIEW_MS=30000
# STUB_ADS_LATENCY_MS=120

# CJ Dropshipping (leave blank to use fixtures)
CJ_API_KEY=
CJ_EMAIL=
CJ_PASSWORD=
USE_CATALOG_FIXTURES=true

# ---- Order emails (Phase 1 slice 2) ----
# Blank → dev outbox: emails are rendered and saved to EMAIL_OUTBOX_DIR (+ visible in admin → Emails), not sent.
RESEND_API_KEY=
# Must be on a domain verified in Resend (SPF + DKIM records). Display name is the shop's name.
EMAIL_FROM_ADDRESS=orders@storeforge.local
# EMAIL_OUTBOX_DIR=./.outbox
# Crash recovery sweep (ms; 0 = off): PAID orders without fulfilment, unsent QUEUED emails,
# order refunds stuck pending/unknown (reconciled against Stripe every 5th sweep).
ORDER_SWEEP_MS=60000

# ---- Custom domains (Phase 1 slice 2) ----
# stub (default): no real DNS lookups; admin shows "Simulate DNS". live: query public resolvers.
DOMAIN_DNS_MODE=stub
# DOMAIN_DNS_SERVERS=1.1.1.1,8.8.8.8
# Hostname merchants CNAME to (default stores.<NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN>)
DOMAIN_CNAME_TARGET=
# Comma-separated public IPs of the storefront edge, for root (apex) domains' A records
DOMAIN_APEX_IPS=
# TLS: stub (default, simulated) | caddy (on-demand TLS; we probe HTTPS) | vercel (Domains API)
DOMAIN_TLS_PROVIDER=stub
# Shared secret Caddy sends to GET /api/domains/tls-ask?domain=…&token=…
# REQUIRED for caddy (24+ random chars): the API refuses to start without it.
DOMAIN_TLS_ASK_TOKEN=
# Vercel only: API token + project the storefront is deployed to
DOMAIN_PROVIDER_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Sweeper interval (ms; 0 = off), stub cert delay, give-up windows
# DOMAIN_SWEEP_MS=15000
# DOMAIN_STUB_TLS_DELAY_MS=20000
# DOMAIN_DNS_TIMEOUT_HOURS=72
# DOMAIN_TLS_TIMEOUT_MIN=30
# The HTTPS check connects only to the edge IP DNS verification matched, never to private /
# loopback / link-local ranges. Local Caddy testing only (ignored in production):
# DOMAIN_PROBE_ALLOW_PRIVATE=true
# Storefront → API, server-side (middleware host lookups + the /api proxy the shop pages use).
# Read at storefront BUILD time for the proxy; defaults to NEXT_PUBLIC_API_URL.
# STOREFRONT_API_URL=http://api:4000
# Storefront: X-Forwarded-Host is honoured only from these proxy addresses (IPs/CIDRs, or
# "loopback"); everyone else is routed by the Host header. Blank = never trust it.
# Needs `pnpm start` (server.mjs), which tells the middleware the real peer address.
TRUSTED_PROXIES=

# Media (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Feature flags
AUTO_FULFILL_ENABLED=false
SEED_SKU_COUNT=300
# Manual POST /api/orders/:id/stub-pay — requires this flag + merchant auth.
# Leave false/unset in production. Checkout without Stripe keys still auto-marks PAID.
ALLOW_STUB_PAY=false
