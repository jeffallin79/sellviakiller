# Copy THIS file to .env. Testers: never copy a build box's .env (it is a local demo file with
# ALLOW_STUB_PAY=true and other dev-only settings).

# Database / Redis
DATABASE_URL=postgresql://storeforge:storeforge@localhost:5432/storeforge?schema=public
REDIS_URL=redis://localhost:6379

# App URLs
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3001
STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN=storeforge.local

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:4000
# Cookie / trusted origins (comma-separated)
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://admin.storeforge.local:3001

# Payments: Stripe (switched from Square 2026-11-12). Leave STRIPE_SECRET_KEY blank = stub mode.
# Use TEST keys (sk_test_/pk_test_). Live keys are refused unless STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Platform webhook endpoint  {API_URL}/api/webhooks/stripe  (signing secret whsec_…)
STRIPE_WEBHOOK_SECRET=
# Connect webhook endpoint   {API_URL}/api/webhooks/stripe/connect  ("Events on connected accounts")
STRIPE_CONNECT_WEBHOOK_SECRET=
# STRIPE_CONNECT_CLIENT_ID — UNUSED. Only for OAuth-style Connect (Standard accounts); StoreForge uses
# Express accounts onboarded with Account Links, so leave it unset.
# STRIPE_CONNECT_CLIENT_ID=
# Recurring monthly Price ids for the plans ($29 / $79 / $199)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_ALLOW_LIVE=false
# Platform application fee on storefront orders, basis points (0 = none; plans carry revenue)
PLATFORM_FEE_BPS=0
# Ad Fuel refunds: processor-cost deduction (blueprint "minus processor costs"); 0 until decided
FUEL_REFUND_FEE_BPS=0
FUEL_REFUND_FEE_FIXED_CENTS=0
# How often pending/unknown Ad Fuel refunds are confirmed against Stripe (ms; 0 = off)
FUEL_RECONCILE_MS=600000

# CJ Dropshipping (leave blank to use fixtures)
CJ_API_KEY=
CJ_EMAIL=
CJ_PASSWORD=
USE_CATALOG_FIXTURES=true

# ---- Order emails (Phase 1 slice 2) ----
# Blank → dev outbox: emails are rendered and saved to EMAIL_OUTBOX_DIR (+ visible in admin → Emails), not sent.
RESEND_API_KEY=
# Must be on a domain verified in Resend (SPF + DKIM records). Display name is the shop's name.
EMAIL_FROM_ADDRESS=orders@storeforge.local
# EMAIL_OUTBOX_DIR=./.outbox

# ---- Custom domains (Phase 1 slice 2) ----
# stub (default): no real DNS lookups; admin shows "Simulate DNS". live: query public resolvers.
DOMAIN_DNS_MODE=stub
# DOMAIN_DNS_SERVERS=1.1.1.1,8.8.8.8
# Hostname merchants CNAME to (default stores.<NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN>)
DOMAIN_CNAME_TARGET=
# Comma-separated public IPs of the storefront edge, for root (apex) domains' A records
DOMAIN_APEX_IPS=
# TLS: stub (default, simulated) | caddy (on-demand TLS; we probe HTTPS) | vercel (Domains API)
DOMAIN_TLS_PROVIDER=stub
# Shared secret Caddy sends to GET /api/domains/tls-ask?domain=…&token=… (recommended for caddy)
DOMAIN_TLS_ASK_TOKEN=
# Vercel only: API token + project the storefront is deployed to
DOMAIN_PROVIDER_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Sweeper interval (ms; 0 = off), stub cert delay, give-up windows
# DOMAIN_SWEEP_MS=15000
# DOMAIN_STUB_TLS_DELAY_MS=20000
# DOMAIN_DNS_TIMEOUT_HOURS=72
# DOMAIN_TLS_TIMEOUT_MIN=30
# Storefront middleware → API (server-side; defaults to NEXT_PUBLIC_API_URL)
# STOREFRONT_API_URL=http://api:4000

# Media (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Feature flags
AUTO_FULFILL_ENABLED=false
SEED_SKU_COUNT=300
# Manual POST /api/orders/:id/stub-pay — requires this flag + merchant auth.
# Leave false/unset in production. Checkout without Stripe keys still auto-marks PAID.
ALLOW_STUB_PAY=false
