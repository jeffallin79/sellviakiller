# Database / Redis
DATABASE_URL=postgresql://storeforge:storeforge@localhost:5432/storeforge?schema=public
REDIS_URL=redis://localhost:6379

# App URLs
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3001
STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN=storeforge.local

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:4000
# Cookie / trusted origins (comma-separated)
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://admin.storeforge.local:3001

# Square (SaaS subscriptions + storefront checkout) — NEVER Stripe
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_ENVIRONMENT=sandbox
# Subscription plan / catalog item IDs from Square Dashboard (sandbox OK)
SQUARE_PLAN_STARTER_ID=
SQUARE_PLAN_GROWTH_ID=
SQUARE_PLAN_SCALE_ID=
# Optional platform application fee (basis points, e.g. 100 = 1%)
SQUARE_PLATFORM_FEE_BPS=100

# CJ Dropshipping (leave blank to use fixtures)
CJ_API_KEY=
CJ_EMAIL=
CJ_PASSWORD=
USE_CATALOG_FIXTURES=true

# Email / media (optional Phase 0)
RESEND_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Feature flags
AUTO_FULFILL_ENABLED=false
SEED_SKU_COUNT=300
# Manual POST /api/orders/:id/stub-pay — requires this flag + merchant auth.
# Leave false/unset in production. Checkout without Square still auto-marks PAID.
ALLOW_STUB_PAY=false
